{
  "name": "ActiveSession",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the account holding this session"
    },
    "device_id": {
      "type": "string",
      "description": "Device ID this session is bound to"
    },
    "heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat timestamp; a session older than the timeout is considered inactive"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this session is considered active"
    },
    "token_issued_at": {
      "type": "number",
      "description": "The `iat` claim of the exact WordPress JWT whose login created (or last re-authenticated) this session row \u2014 that login's 'generation'. Content reads and heartbeats only count when the caller's own token carries this same iat, so an older still-valid token (from before a forced logout, a logout, or a newer login on any device) no longer matches the row and stays revoked (audit U1/U2, 2026-09-23). Rows created before this field existed have it unset and are treated as legacy."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text notes for internal reference."
    }
  },
  "required": [
    "user_email",
    "device_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}