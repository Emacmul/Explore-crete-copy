{
  "name": "Translation",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "The i18n key being overridden (e.g. 'home.logout')."
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "nl",
        "cs",
        "fr",
        "de",
        "es",
        "pt",
        "it",
        "el",
        "pl",
        "ro",
        "hu",
        "ru",
        "tr",
        "sh",
        "he",
        "ar",
        "no",
        "da",
        "sv",
        "fi",
        "bg",
        "sl"
      ],
      "description": "UI language code this override applies to."
    },
    "value": {
      "type": "string",
      "description": "The corrected text for this key in this language."
    },
    "edited_by_email": {
      "type": "string",
      "description": "Email of the admin/narrator who last saved this override. Never served to clients \u2014 getTranslationOverrides (the only read path, used by the customer app and the editing tool alike) strips it from every response (2026-09-24 security review), and direct entity reads are admin-only via RLS."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text notes for internal reference."
    }
  },
  "required": [
    "key",
    "lang",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}