{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "WordPress user ID (set on first login via ensureAppUserOnboarding, or by the sync). Not a Base44 user id — real customers never have a Base44 session."
    },
    "email": {
      "type": "string",
      "description": "Email address (lowercased)"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "narrator",
        "admin"
      ],
      "default": "user",
      "description": "user = front-end only; narrator = translates cloned tours via the Narr button; admin = full backend via Base44 sign-in. Only ever changed by an admin through saveAppUserAdmin."
    },
    "date_of_birth": {
      "type": "string",
      "description": "Date of birth (YYYY-MM-DD)"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ],
      "description": "Gender"
    },
    "password": {
      "type": "string",
      "description": "Backend password — required for Narrator and Admin roles."
    },
    "narr_session_token": {
      "type": "string",
      "description": "Random token issued at successful Narr Studio login, letting authenticated actions (like saving a UI translation) skip re-entering the password for the rest of that login — the password itself is genuinely verified once, at login, not bypassed."
    },
    "google_tts_api_key": {
      "type": "string",
      "description": "This admin/narrator's own Google Cloud Text-to-Speech API key, used for narration audio generation. Kept separate per person so usage and any cost stays personal to them, not shared across everyone."
    },
    "groq_api_key": {
      "type": "string",
      "description": "This admin/narrator's own Groq API key, used for the script translation feature."
    },
    "groq_api_key_2": {
      "type": "string",
      "description": "Optional backup Groq API key from a SEPARATE Groq account — Groq's rate limits are per-account, so this gives a second, independent budget to fall back on automatically when the primary key hits a rate limit. Never required; blank means no backup is set."
    },
    "narr_session_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When narr_session_token stops being valid. Refreshed on each Narr Studio login."
    },
    "newsletter_opted_in": {
      "type": "boolean",
      "default": true,
      "description": "Whether user has opted into newsletter emails"
    },
    "registration_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether profile setup is complete"
    },
    "purchased_walk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of walks this person has purchased — set automatically when Creem confirms a payment, never edited by hand"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text notes for internal reference."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
