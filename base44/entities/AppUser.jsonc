{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "narrator",
        "admin"
      ],
      "default": "user",
      "description": "user = front-end only; narrator = translates cloned tours via the Narr button; admin = full backend via Base44 sign-in."
    },
    "date_of_birth": {
      "type": "string",
      "description": "Date of birth (YYYY-MM-DD)"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ],
      "description": "Gender"
    },
    "password": {
      "type": "string",
      "description": "Backend password \u2014 required for Narrator and Admin roles."
    },
    "newsletter_opted_in": {
      "type": "boolean",
      "default": true,
      "description": "Whether user has opted into newsletter emails"
    },
    "registration_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether profile setup is complete"
    },
    "purchased_walk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of walks this person has purchased \u2014 set automatically when Creem confirms a payment, never edited by hand"
    }
  },
  "required": [
    "email"
  ]
}