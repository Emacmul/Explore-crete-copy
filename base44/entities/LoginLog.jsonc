{
  "name": "LoginLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the Narrator/Admin who logged in (lowercased) \u2014 or, for FAILED attempts, the email the attempt was made WITH, whether or not any such account exists."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ],
      "default": "success",
      "description": "success = the login fully succeeded; failed = the attempt was rejected (unknown account, account without a Narrator/Admin role, locked account, or wrong password). Rows written before this field existed are successful sign-ins."
    },
    "failure_reason": {
      "type": "string",
      "description": "For failed attempts only: why the login was rejected \u2014 unknown_account, not_staff, wrong_password or account_locked."
    },
    "login_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the login actually happened (server time). created_date is when the log row was written \u2014 for backfilled rows reconstructed from older device records, login_at carries the TRUE login time while created_date is the backfill write time."
    },
    "role": {
      "type": "string",
      "description": "The staff role held at login time: narrator, admin or super_admin. Empty on failed attempts (the role is not revealed \u2014 and for an unknown account there is none)."
    },
    "login_type": {
      "type": "string",
      "enum": [
        "front_end",
        "narr_studio"
      ],
      "description": "Where the login happened: front_end = the customer WordPress login (loginWithDeviceCheck, staff branch), narr_studio = the backend password login (narrLogin, used by both the Narr button and the Admin page)."
    },
    "device_id": {
      "type": "string",
      "description": "Device id the front-end login came from (device fingerprints; empty for narr_studio logins, which carry no device id yet)."
    },
    "device_label": {
      "type": "string",
      "description": "Friendly browser/OS hint for the device, e.g. 'Chrome on Windows'."
    },
    "ip": {
      "type": "string",
      "description": "Caller IP for narr_studio logins, when the platform passes an x-forwarded-for header \u2014 best-effort, may be empty (or a load balancer's address). Never present for front_end logins, which the app only sees after WordPress has already authenticated the person."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text notes for internal reference."
    }
  },
  "required": [
    "user_email",
    "login_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}