{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "buyer_email": {
      "type": "string",
      "description": "Email of the customer who bought the walk (lowercased). Identifies the owner for access checks — matched against the logged-in user's email."
    },
    "creem_product_id": {
      "type": "string",
      "description": "The product ID at the Merchant of Record that was purchased. Matched against Walk.creem_product_id to grant access — NOT a loose text match on the walk code."
    },
    "walk_id": {
      "type": "string",
      "description": "The Walk record this purchase grants access to (resolved by creem_product_id at recording time). May be null if no walk matched the product id yet (recorded anyway for support + future-proofing)."
    },
    "walk_name": {
      "type": "string",
      "description": "Snapshot of the walk name at purchase time, for support lookups."
    },
    "processor": {
      "type": "string",
      "enum": [
        "creem",
        "paddle",
        "manual"
      ],
      "description": "How ownership was granted: creem/paddle = a real payment via that Merchant of Record; manual = an admin gifted this walk for free (birthday raffle, etc.). All three flow through the same entitlement check."
    },
    "transaction_id": {
      "type": "string",
      "description": "Order/checkout ID from the processor — used to dedupe redelivered webhooks so a repeat delivery never creates a duplicate record. Null for manual grants (deduped by email + product id instead)."
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the purchase was recorded (webhook arrival time, or the manual grant time)."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "active = currently grants access; revoked = access was removed after a refund or chargeback on this purchase (see accessRevoker.ts). The record is kept rather than deleted, so a redelivered/retried checkout.completed webhook for the same transaction can never silently recreate access after a legitimate refund (audit finding U-05, 2026-09-09 review) — recordPurchase treats an existing revoked row for the same transaction as a dedupe match, not a fresh grant. A genuine repurchase (a new transaction id) still creates a normal new record. Older records predating this field have no status set and are treated as active everywhere this is checked."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this purchase was revoked, if applicable. Cleared back to empty if access is later restored (e.g. a won dispute)."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text notes for internal reference."
    }
  },
  "required": [
    "buyer_email",
    "creem_product_id",
    "processor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
