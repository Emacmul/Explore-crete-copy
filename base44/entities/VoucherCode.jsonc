{
  "name": "VoucherCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique voucher or download code"
    },
    "walk_id": {
      "type": "string",
      "description": "ID of the walk this code unlocks"
    },
    "walk_name": {
      "type": "string",
      "description": "Name of the walk"
    },
    "entitlement_type": {
      "type": "string",
      "enum": [
        "purchase",
        "member_included",
        "admin_grant"
      ],
      "default": "purchase",
      "description": "How the user became entitled to this walk"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Email address of the user this code is assigned to"
    },
    "gpx_url": {
      "type": "string",
      "description": "Download URL for the GPX file"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has already been used"
    },
    "used_by": {
      "type": "string",
      "description": "Email of the user who used the code"
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code was used"
    }
  },
  "required": [
    "code",
    "walk_id"
  ]
}